<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- App Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/settings_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Live Preview Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/preview_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/system_neutral1_800"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="16dp">

                <include layout="@layout/widget_classic_search" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section: System & Shizuku Status -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/section_system_status"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_shizuku_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row 1: Shizuku Service -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_shizuku_status"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_shizuku_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checking..."
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Row 2: WRITE_SECURE_SETTINGS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_write_secure_status"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_write_secure_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Granted"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Row 3: All Apps Search Service (Accessibility) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_a11y_status"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_a11y_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inactive"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Action Button: Request Shizuku Permission -->
                <Button
                    android:id="@+id/btn_request_shizuku"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_request_shizuku" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section 1: Dock Integration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/section_dock_integration"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_replace_dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/option_replace_dock"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/txt_dock_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.75"
                    android:text="@string/option_replace_dock_desc"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Outer Frame & Surface Contrast -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/section_frame_color"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <RadioGroup
                android:id="@+id/rg_frame_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <RadioButton
                    android:id="@+id/rb_frame_deep"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/frame_style_deep"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/rb_frame_pastel"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/frame_style_pastel"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/rb_frame_rich"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/frame_style_rich"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </RadioGroup>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: Icon Color Fragmentation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/section_icon_color"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <RadioGroup
                android:id="@+id/rg_icon_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <RadioButton
                    android:id="@+id/rb_icon_ref"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/icon_style_ref"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/rb_icon_mono"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/icon_style_mono"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <RadioButton
                    android:id="@+id/rb_icon_color"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/icon_style_color"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

            </RadioGroup>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: Opacity -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.75"
            android:letterSpacing="0.08"
            android:text="@string/section_appearance"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/label_opacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/option_opacity"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <TextView
                        android:id="@+id/txt_opacity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:min="30"
                    android:progress="100" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_pin_widget"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_add_widget" />

        <Button
            android:id="@+id/btn_save_config"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_save" />

    </LinearLayout>

</ScrollView>
