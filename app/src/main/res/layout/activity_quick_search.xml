<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quick_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#26000000"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Reference #5: Dual-Block Frosted Glass Dock Morph Container
         - When opened from Home Screen Widget: anchored at BOTTOM right above keyboard
           (order: Deep Chips Pill -> App Icon Dock Pill -> Search Capsule)
         - When opened from All Apps Drawer: anchored at TOP covering the native search bar
           (order: Search Capsule -> App Icon Dock Pill -> Deep Chips Pill) -->
    <LinearLayout
        android:id="@+id/quick_panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Tier 2: Compact Deep Matches & Contacts Frosted Glass Pill
             (Contacts with Call button, System Settings, App Shortcuts, Google Ecosystem triggers) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_deep_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1.2dp">

            <HorizontalScrollView
                android:id="@+id/scroll_deep_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_deep_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tier 1: Primary Minimalist Icon Dock Frosted Glass Pill
             (Matched Apps + 1 Default Search/AI circle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_icon_dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="44dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1.2dp">

            <HorizontalScrollView
                android:id="@+id/scroll_icon_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/row_dock_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Exact 1:1 Replica of Home Screen Search Widget Capsule -->
        <LinearLayout
            android:id="@+id/quick_outer_ring"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- Inner search capsule (Google G + EditText + Mic + Middle / Clear X) -->
            <LinearLayout
                android:id="@+id/quick_inner_pill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="9dp">

                <ImageView
                    android:id="@+id/img_quick_logo"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/cd_google_search"
                    android:padding="3dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_google_logo_ref" />

                <EditText
                    android:id="@+id/edit_quick_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint=""
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/widget_hint_text"
                    android:textSize="16.5sp" />

                <ImageView
                    android:id="@+id/btn_quick_mic"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_voice_search"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic_ref" />

                <ImageView
                    android:id="@+id/btn_quick_middle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_gemini_app"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gemini_ref" />

                <ImageView
                    android:id="@+id/btn_quick_clear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/cancel"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close_24"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Concentric ring gap spacer -->
            <View
                android:id="@+id/quick_ring_gap_spacer"
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <!-- Right AI Circle Button (exact match with home screen widget) -->
            <FrameLayout
                android:id="@+id/quick_ai_circle_wrapper"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btn_quick_ai"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_ai_mode"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ai_mode_ref" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
