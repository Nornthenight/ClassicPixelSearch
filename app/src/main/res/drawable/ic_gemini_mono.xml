                android:endX="22"
                android:endY="18"
                android:type="linear">
                <item android:offset="0.0" android:color="@color/widget_icon_secondary" />
                <item android:offset="0.5" android:color="@color/widget_icon_tertiary" />
                <item android:offset="1.0" android:color="@color/widget_icon_deep" />
