        android:pathData="M12,2 C11.6,7.2 7.2,11.6 2,12 C7.2,12.4 11.6,16.8 12,22 L12,2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="2"
                android:startY="12"
                android:endX="12"
                android:endY="22"
                android:type="linear">
                <item android:offset="0.0" android:color="@color/widget_icon_deep" />
                <item android:offset="0.6" android:color="@color/widget_icon_primary" />
